# Zig build output and cache
zig-out/
.zig-cache/
zig-cache/

# Downloaded / generated boot artifacts (produced by tools/fetch_artifacts.sh):
# kernels, busybox, initramfs, disk images, shared dirs — none belong in git.
/artifacts/

# Test-kernel build intermediates. The committed inputs are test/*.S and the
# @embedFile'd src/testdata/*.bin; the linked .elf objects are regenerated.
test/*.elf
test/*.o

# OCI pull/run scratch (generated by `contain oci` / `contain pull`).
/oci-rootfs/
/oci-initramfs.cpio

# Local scratch
*.exe
cmds.txt
*.log

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Kernel build cache (tools/build_kernel.sh)
/.kbuild/
